{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build coeficiente_variacao",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-fopenmp",
                "-O0", // Reduzir otimizações facilita depuração
                "${workspaceFolder}/desafios/coeficiente_variacao/main.cpp",
                "${workspaceFolder}/desafios/coeficiente_variacao/coeficiente_variacao.cpp",
                "-o",
                "${workspaceFolder}/desafios/coeficiente_variacao/main.out"
            ],
            "options": {
                "cwd": "${workspaceFolder}/desafios/coeficiente_variacao"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: build 04_convolucao (debug, -O0)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0", // Sem otimizações: o depurador acompanha o fonte
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/seminario/baseline/04_convolucao.cpp",
                "-o",
                "${workspaceFolder}/seminario/baseline/convolucao_debug.out"
            ],
            "options": {
                "cwd": "${workspaceFolder}/seminario/baseline"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}